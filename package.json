{
  "name": "piches",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:essensia": "vite --mode essensia",
    "dev:linnartistry": "vite --mode linnartistry",
    "build:essensia": "tsc --noEmit && vite build --mode essensia",
    "build:linnartistry": "tsc --noEmit && vite build --mode linnartistry",
    "build:all": "npm run build && npm run build:essensia && npm run build:linnartistry",
    "deploy": "node scripts/deploy-hostinger.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.83.0",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tus-js-client": "^4.3.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "^3.2.7"
  }
}
